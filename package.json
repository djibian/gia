{
  "name": "gia",
  "version": "0.7.0",
  "private": true,
  "description": "Gia, a compact MCP adaptation layer for Grist Community.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "test": "node --import tsx --test test/*.test.ts test/*.test.mjs",
    "probe:chatgpt-oauth-readiness": "node --import tsx tools/chatgpt-oauth-readiness-probe.ts",
    "credential:principal-id": "node --import tsx tools/oauth-principal-id.ts",
    "check:oauth-deployment": "node --import tsx tools/oauth-deployment-preflight.ts",
    "smoke:oauth-deployment": "node --import tsx tools/oauth-operational-smoke.ts",
    "check:convergence": "node tools/check-convergence.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
