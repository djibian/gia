# Controlled R3 candidate configuration. Never commit real secrets.
GRIST_BASE_URL=https://grist.example.org
GRIST_API_KEY=

# Deployment resource ceiling: configure at least one document or workspace ID.
GRIST_ALLOWED_DOCUMENT_IDS=
GRIST_ALLOWED_WORKSPACE_IDS=

# Bridge capability ceiling for the MCP principal. Defaults to all three.
# Allowed: doc:read,doc:write,doc.schema:write
MCP_CAPABILITIES=doc:read,doc:write,doc.schema:write

# Guardrails; 0 means no bridge-side maximum.
GRIST_MAX_READ_RECORDS=5000
GRIST_MAX_WRITE_RECORDS=500
GRIST_MAX_SCHEMA_ITEMS=100
# Large record mutations are sent sequentially in batches. The group is not
# atomic; confirmed partial success is reported explicitly.
GRIST_WRITE_BATCH_RECORDS=200

# MCP authentication: static (default) for a controlled instance, or oauth.
MCP_AUTH_MODE=static
# Required only in static mode; use a random value of at least 32 characters.
MCP_BEARER_TOKEN=
# OAuth mode is provider-neutral and requires all three HTTPS URLs below.
# OAUTH_ISSUER=https://auth.example.org/oidc
# OAUTH_JWKS_URI=https://auth.example.org/oidc/jwks
# MCP_RESOURCE_URI=https://mcp.example.org/mcp

# Public hostnames accepted by the MCP HTTP endpoint. Localhost entries are
# always accepted. The process itself binds only to localhost; use a reverse
# proxy for remote HTTPS access.
MCP_ALLOWED_HOSTS=
PORT=3000
HOST=127.0.0.1
